<UserControl x:Class="WpfDesignPractice2.ClearableTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfDesignPractice2"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="200">
    <Grid>
        <TextBox x:Name="textBox" Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Margin="0" Padding="5" VerticalContentAlignment="Center"/>
        <Button x:Name="clearButton" Content="X" Width="20" Height="20" 
                HorizontalAlignment="Right" Margin="0,0,5,0"
                Click="ClearButton_Click" Style="{StaticResource AnimatedInteractiveButton}"/>
    </Grid>
    
</UserControl>
