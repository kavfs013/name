<Window x:Class="WpfDesignPractice2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDesignPractice2"
        mc:Ignorable="d"
       Title="Multi-Form Interface" Height="450" Width="500" MinHeight="400" MinWidth="450">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrandColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="ButtonTextColor" Color="White"/>
        <SolidColorBrush x:Key="HeadingColor" Color="#333333"/>
        <Thickness x:Key="ControlMargin">6</Thickness>
        <Style x:Key="FormHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource HeadingColor}"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- label -->
        <Style x:Key="FormLabelStyle" TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="{StaticResource ControlMargin}"/>
        </Style>

        <!-- textBox -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="{StaticResource ControlMargin}"/>
        </Style>

        <!-- Стиль для кнопок действий -->
        <Style x:Key="FormButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrandColor}"/>
            <Setter Property="Foreground" Value="{StaticResource ButtonTextColor}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,15,5,5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <!--3 проблемы композиции и выравнивания:
        1.неравномерные отступы-элементы расположены слишком близко друг к другу, из-за чего все выглядит тесным
        2.нарушено вертикальное выравнивание-Name,Email,Bio имеют разные расстояния
        3.кнопка Save Profile плохо выделена-сливается с остальными элементами-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="41.28"/>
            <RowDefinition Height="Auto" MinHeight="31"/>
            <RowDefinition Height="Auto" MinHeight="46"/>
            <RowDefinition Height="99*"/>
            <RowDefinition Height="113*"/>
            <RowDefinition Height="Auto" MinHeight="73.76"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                               Text="User Profile" Style="{StaticResource FormHeadingStyle}"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Username:" Style="{StaticResource FormLabelStyle}"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="danir" Style="{StaticResource ModernTextBox}" Margin="0,10,0,10"/>
        <Label Grid.Row="2" Grid.Column="0" Content="email:" Style="{StaticResource FormLabelStyle}"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="lox@bk.ru" Style="{StaticResource ModernTextBox}" Margin="0,10,0,10"/>

        <Label Grid.Row="3" Grid.Column="0" Content="bio:" Style="{StaticResource FormLabelStyle}"/>
        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernTextBox}" AcceptsReturn="True" VerticalAlignment="Stretch" Margin="0,10,0,10"/>
        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="Save Profile" 
                Style="{StaticResource AnimatedInteractiveButton}" 
                Width="150" Height="40"/>
    </Grid>
</Window>
    